# ============================================================
# SAKLOLO 161 - MIDDLEWARE GATEWAY ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to version control.
# ============================================================

# Server ---------------------------------------------------
PORT=5000
NODE_ENV=development

# OpenWeatherMap API -----------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Mapbox Geocoding API ---------------------------------------
# Used by services/mapboxService.js to reverse-geocode
# incoming GPS coordinates (lat/lng) into a readable address,
# and by services/routingService.js for driving directions
# (GET /api/routes, Phase 3).
# Get a token at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# PAGASA River Feed (Phase 3) --------------------------------
# Public DOST-PAGASA Pasig-Marikina-Tullahan FFWS station table.
# No API key required. The service degrades to the in-memory mock
# whenever the feed is unreachable, so these are optional.
PAGASA_RIVER_ENDPOINT=https://pasig-marikina-tullahanffws.pagasa.dost.gov.ph/water/table_list.do
PAGASA_RIVER_STATION=Nangka

# Semaphore SMS API -------------------------------------------
# Used by services/semaphoreService.js to send SMS
# notifications/updates to citizens who reported an incident.
# Get an API key at: https://semaphore.co/
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SAKLOLO161

# Firebase ------------------------------------------------------
# Used by config/firebase.js (Firebase Admin v14 — one init for both
# the Realtime Database and Firebase Auth). Provide credentials via
# ONE of these two options:
#
# Option A — LOCAL DEVELOPMENT: path to a downloaded service-account
# JSON file. The file is gitignored (config/serviceAccountKey.json)
# and must NEVER be committed.
FIREBASE_CREDENTIALS=./config/serviceAccountKey.json
#
# Option B — CI / RENDER (preferred where files can't be committed):
# the same service-account JSON pasted as a single-line environment
# variable. config/firebase.js uses this automatically when set and
# prefers it over Option A if both are present. NEVER commit a real
# value; in GitHub Actions supply it as a repository secret, in
# Render as an environment variable.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project", "...":"..."}
#
# Required RTDB instance URL (both options need it):
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Auth — Web API key -------------------------------------
# Firebase Console -> Project Settings -> General -> Web API key.
# Required for POST /api/auth/login (Auth REST signInWithPassword)
# and by the contract test suite's login helpers. Local secret:
# .env only (gitignored) / GitHub Actions secret / Render env var.
# Never logged, never committed.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Station Duty Phones (Phase 2 - dynamic station routing) -------
# Used by config/stations.js via config/env.js. Replace with the
# REAL duty numbers in Render's environment settings — the values
# below are safe local-dev placeholders only, never real numbers.
MDRRMO_BASE_PHONE=+639170000001
ARMMC_ER_PHONE=+639170000002
BFP_MAIN_STATION_PHONE=+639170000003
BFP_STATION_2_PHONE=+639170000004
RIVER_COMMAND_PHONE=+639170000005
PNP_MAIN_HQ_PHONE=+639170000006
PNP_SUBSTATION_PHONE=+639170000007

# JWT Auth (legacy Phase 2 — no longer used) ----------------------
# services/authService.js now verifies Firebase ID tokens against
# custom claims; there is no signing secret anymore. This variable
# is kept only for backward compatibility and is safe to ignore.
JWT_SECRET=your_strong_jwt_secret_here
